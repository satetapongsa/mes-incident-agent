# Copy to .env and change the values. .env is git-ignored.

# --- Oracle ---
ORACLE_SYS_PASSWORD=OracleSys_2026
ORACLE_APP_PASSWORD=MesApp_2026
ORACLE_PORT=1521

# --- Internal service token (header X-Service-Token for write endpoints of remedy-api) ---
SERVICE_TOKEN=change-me-service-token

# --- LLM (Grok via xAI, OpenAI-compatible API) ---
# LLM_MODE: auto = use Grok when XAI_API_KEY is set, otherwise mock
#           mock = always use the offline rule-based planner
#           llm  = always use the LLM (falls back to mock if the API fails)
LLM_MODE=auto
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# --- Agent limits ---
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SEC=90

# --- Simulator ---
SIM_ENABLED=false
SIM_INTERVAL_SEC=300
