# Copy to .env and change the values. .env is git-ignored.

# --- Oracle ---
ORACLE_SYS_PASSWORD=OracleSys_2026
ORACLE_APP_PASSWORD=MesApp_2026
ORACLE_PORT=1521

# --- Internal service token (header X-Service-Token for write endpoints of remedy-api) ---
SERVICE_TOKEN=change-me-service-token

# --- LLM (any OpenAI-compatible API; default Groq) ---
# LLM_MODE: auto = use the LLM when LLM_API_KEY is set, otherwise the offline mock planner
#           mock = always use the mock planner
# If the LLM API fails, the run falls back to the mock planner.
# Groq key: https://console.groq.com/keys   (xAI Grok: LLM_BASE_URL=https://api.x.ai/v1, LLM_MODEL=grok-4)
LLM_MODE=auto
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
# gpt-oss only: low = faster, fewer tokens (free tier: 8,000 tokens/minute)
LLM_REASONING_EFFORT=low

# --- Agent limits ---
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SEC=90
# Auto mode: agent analyses every New ticket by itself (fixes still need approval). Can be switched in the web UI.
AUTO_AGENT=false
AUTO_POLL_SEC=20

# --- Simulator ---
SIM_ENABLED=false
SIM_INTERVAL_SEC=300
